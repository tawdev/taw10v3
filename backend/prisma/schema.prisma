generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum PricingTheme {
  DEFAULT
  FEATURED
  PREMIUM
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model AdminUser {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model PricingPlan {
  id          String           @id @default(cuid())
  name        String
  price       Int
  description String           @db.Text
  theme       PricingTheme     @default(DEFAULT)
  isPopular   Boolean          @default(false)
  isActive    Boolean          @default(true)
  sortOrder   Int              @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  features    PricingFeature[]

  @@map("pricing_plans")
}

model PricingFeature {
  id         String      @id @default(cuid())
  planId     String
  name_fr    String
  name_ar    String
  name_en    String
  isIncluded Boolean     @default(true)
  sortOrder  Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  plan       PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sortOrder])
  @@index([planId])
  @@map("pricing_features")
}

model Customer {
  id          String   @id @default(cuid())
  fullName    String
  email       String?  @unique
  phone       String   @unique
  companyName String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@map("customers")
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_DOCUMENTS
  COMPLETED
  CANCELLED
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerId   String?
  customerName String
  phone        String
  email        String?
  selectedPlan String
  status       OrderStatus @default(PENDING)
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("orders")
}

model ContactMessage {
  id        String   @id @default(cuid())
  nom       String
  prenom    String
  email     String
  phone     String?
  service   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model BlogArticle {
  id              String     @id @default(cuid())
  title           String
  title_fr        String?
  title_en        String?
  title_ar        String?
  slug            String     @unique
  featuredImage   String
  excerpt         String     @db.Text
  excerpt_fr      String?    @db.Text
  excerpt_en      String?    @db.Text
  excerpt_ar      String?    @db.Text
  content         String     @db.Text
  content_fr      String?    @db.Text
  content_en      String?    @db.Text
  content_ar      String?    @db.Text
  metaTitle       String
  metaTitle_fr    String?
  metaTitle_en    String?
  metaTitle_ar    String?
  metaDescription String     @db.Text
  metaDescription_fr String?  @db.Text
  metaDescription_en String?  @db.Text
  metaDescription_ar String?  @db.Text
  status          BlogStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishedAt])
  @@map("blog_articles")
}

model TeamMember {
  id             String   @id @default(cuid())
  name_fr        String
  name_en        String
  name_ar        String
  role_fr        String
  role_en        String
  role_ar        String
  description_fr String  @db.Text
  description_en String  @db.Text
  description_ar String  @db.Text
  imageUrl       String
  sortOrder      Int     @unique
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("team_members")
}

model ServiceOffering {
  id             String   @id @default(cuid())
  slug           String   @unique
  title_fr       String
  title_en       String
  title_ar       String
  description_fr String  @db.Text
  description_en String  @db.Text
  description_ar String  @db.Text
  icon           String
  imageUrl       String
  sortOrder      Int     @unique
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("service_offerings")
}

model FaqItem {
  id           String   @id @default(cuid())
  question_fr  String
  question_en  String
  question_ar  String
  answer_fr    String   @db.Text
  answer_en    String   @db.Text
  answer_ar    String   @db.Text
  sortOrder    Int      @unique
  isActive     Boolean  @default(true)
  likeCount    Int      @default(0)
  dislikeCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("faq_items")
}
