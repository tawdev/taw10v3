generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model PricingPlan {
  id           String           @id @default(cuid())
  name         String
  price        Int
  pricePromo   Int?
  promoName_fr String?
  promoName_ar String?
  promoName_en String?
  description  String           @db.Text
  theme        PricingTheme     @default(DEFAULT)
  isPopular    Boolean          @default(false)
  isActive     Boolean          @default(true)
  sortOrder    Int              @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  features     PricingFeature[]

  @@map("pricing_plans")
}

model PricingFeature {
  id         String      @id @default(cuid())
  planId     String
  name_fr    String
  name_ar    String
  name_en    String
  isIncluded Boolean     @default(true)
  sortOrder  Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  plan       PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sortOrder])
  @@index([planId])
  @@map("pricing_features")
}

model Customer {
  id          String   @id @default(cuid())
  fullName    String
  email       String?  @unique
  phone       String   @unique
  companyName String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@map("customers")
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerName String
  phone        String
  email        String?
  selectedPlan String
  status       OrderStatus @default(PENDING)
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("orders")
}

model ContactMessage {
  id        String   @id @default(cuid())
  nom       String
  prenom    String
  email     String
  phone     String?
  service   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model BlogArticle {
  id                 String     @id @default(cuid())
  title              String
  slug               String     @unique
  featuredImage      String     @map("featured_image")
  excerpt            String     @db.Text
  content            String     @db.Text
  metaTitle          String     @map("meta_title")
  metaDescription    String     @db.Text @map("meta_description")
  keywords           String?    @db.Text
  language           String     @default("fr")
  author             String     @default("TAW 10")
  category           String     @default("Business")
  readingTime        Int        @default(5) @map("reading_time")
  status             BlogStatus @default(DRAFT)
  publishedAt        DateTime?  @map("published_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  content_ar         String?    @db.Text
  content_en         String?    @db.Text
  content_fr         String?    @db.Text
  excerpt_ar         String?    @db.Text
  excerpt_en         String?    @db.Text
  excerpt_fr         String?    @db.Text
  metaDescription_ar String?    @db.Text
  metaDescription_en String?    @db.Text
  metaDescription_fr String?    @db.Text
  metaTitle_ar       String?
  metaTitle_en       String?
  metaTitle_fr       String?
  title_ar           String?
  title_en           String?
  title_fr           String?

  @@index([status, publishedAt])
  @@map("blog_articles")
}

model TeamMember {
  id             String   @id @default(cuid())
  name_fr        String
  name_en        String
  name_ar        String
  role_fr        String
  role_en        String
  role_ar        String
  description_fr String   @db.Text
  description_en String   @db.Text
  description_ar String   @db.Text
  imageUrl       String
  sortOrder      Int      @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("team_members")
}

model ServiceOffering {
  id             String   @id @default(cuid())
  slug           String   @unique
  title_fr       String
  title_en       String
  title_ar       String
  description_fr String   @db.Text
  description_en String   @db.Text
  description_ar String   @db.Text
  icon           String
  imageUrl       String
  sortOrder      Int      @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("service_offerings")
}

model FaqItem {
  id           String   @id @default(cuid())
  sortOrder    Int      @unique
  isActive     Boolean  @default(true)
  likeCount    Int      @default(0)
  dislikeCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  answer_ar    String   @db.Text
  answer_en    String   @db.Text
  answer_fr    String   @db.Text
  question_ar  String
  question_en  String
  question_fr  String

  @@map("faq_items")
}

model SystemSetting {
  id           String   @id @default("default")
  companyName  String   @default("TAW 10")
  phoneNumber  String   @default("+212 5 24 30 80 38")
  email        String   @default("contact@taw10.com")
  address      String   @default("48 Lot IGUIDER, Allal El Fassi, Marrakech")
  facebook     String   @default("https://www.facebook.com/taw10.ma/")
  instagram    String   @default("https://www.instagram.com/tawteen_10/")
  linkedin     String   @default("https://linkedin.com/company/taw10")
  logoUrl      String   @default("/logo.jpeg")
  faviconUrl   String   @default("/favicon.ico")
  updatedAt    DateTime @updatedAt

  @@map("system_settings")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum PricingTheme {
  DEFAULT
  FEATURED
  PREMIUM
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_DOCUMENTS
  COMPLETED
  CANCELLED
}
